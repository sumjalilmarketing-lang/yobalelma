{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hub-app/*": [
        "./apps/hub-app/*"
      ],
      "@user-app/*": [
        "./apps/user-app/*"
      ],
      "@relay-app/*": [
        "./apps/relay-app/*"
      ],
      "@collection-app/*": [
        "./apps/collection-app/*"
      ],
      "@admin-app/*": [
        "./apps/admin-app/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/e2e",
    "apps/*/tests/e2e"
  ]
}
