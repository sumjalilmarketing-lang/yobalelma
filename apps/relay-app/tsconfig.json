{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../*"],
      "@relay-app/*": ["./*"]
    },
    "plugins": [{ "name": "next" }],
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo"
  },
  "include": [
    "../../components/**/*.ts", "../../components/**/*.tsx",
    "../../lib/**/*.ts", "../../packages/**/*.ts", "../../types/**/*.ts",
    ".next/types/**/*.ts", ".next-e2e/types/**/*.ts",
    "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx",
    "middleware.ts", "next-env.d.ts", "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "tests/e2e"]
}
